{
  "expo": {
    "name": "MultiWallet",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sunilsah.multiwallet"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.sunilsah.multiwallet",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "MultiWallet uses the camera to scan payment QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "multiwallet",
    "extra": {
      "eas": {
        "projectId": "2e7ebc07-d456-46b8-8352-8c9a61c8c880"
      }
    },
    "owner": "acsh"
  }
}
